{
  "inbounds": [{
    "listen": "127.0.0.1",
    "port": 0,                     // replaced at runtime by throughput.py
    "protocol": "vless",
    "settings": {
      "clients": [{
        "id": "PLACEHOLDER_UUID",  // replaced at runtime by throughput.py
        "email": "test@local"
      }],
      "decryption": "none"
    },
    "tag": "vless-throughput"
  }],
  "outbounds": [{
    "protocol": "freedom",
    "tag": "direct",
    "settings": { "finalRules": [{ "action": "allow", "network": "tcp", "ip": "127.0.0.1/32", "port": "PLACEHOLDER_ECHO_PORT" }] }
  }]
}
