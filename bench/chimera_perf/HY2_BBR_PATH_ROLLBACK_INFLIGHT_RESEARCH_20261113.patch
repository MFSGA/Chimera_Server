+#[test]
+fn delivery_instrumentation_real_loss_path_releases_snapshot() {
+    let _guard = subscribe();
+    let mut pair = Pair::default();
+    let (client_ch, server_ch) = pair.connect();
+    let before = pair.client_conn_mut(client_ch).delivery_sample_diagnostics();
+    let stream = pair.client_streams(client_ch).open(Dir::Uni).unwrap();
+    pair.client_send(client_ch, stream).write(&[42u8; 4096]).unwrap();
+    pair.client_send(client_ch, stream).finish().unwrap();
+    pair.drive_client();
+    assert!(
+        pair.client_conn_mut(client_ch).delivery_sample_diagnostics().0 > 0,
+        "unacknowledged actual packets must retain snapshots"
+    );
+    pair.server.inbound.clear(); // Drop outgoing traffic once
+    pair.drive(); // QUIC recovers using PTO and retransmissions
+    let accepted = pair.server_streams(server_ch).accept(Dir::Uni).unwrap();
+    assert_eq!(accepted, stream);
+    let mut received = Vec::new();
+    {
+        let mut recv = pair.server_recv(server_ch, stream);
+        let mut chunks = recv.read(true).unwrap();
+        while let Some(chunk) = chunks.next(usize::MAX).unwrap() {
+            received.extend_from_slice(&chunk.bytes);
+        }
+        let _ = chunks.finalize();
+    }
+    let (occupied, sent, acked, discards, _samples) =
+        pair.client_conn_mut(client_ch).delivery_sample_diagnostics();
+    assert!(sent > before.1);
+    assert!(acked > before.2);
+    assert_eq!(received, vec![42u8; 4096]);
+    assert!(discards > before.3, "lost packets must release metadata");
+    assert_eq!(occupied, 0, "loss recovery must not leave orphaned snapshots");
+}
