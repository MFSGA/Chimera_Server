+//! Experimental Xray-style dual-slope sampler and bounded packet metadata pool.
+//! This module is test-only, and does not affect live Quinn/BBR behavior.
+
+use super::SentPacket;
+use crate::Instant;
+use std::num::NonZeroU64;
+
+#[derive(Clone, Copy, Debug)]
+struct SendState {
+    sent_total: u64,
+    acked_total_at_send: u64,
+    last_acked_sent_total: u64,
+    last_acked_sent_ns: u64,
+    last_acked_ack_ns: u64,
+    last_acked_valid: bool,
+    sent_app_limited: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct RateSample {
+    send_bps: Option<u64>, // None = no send-rate constraint, per Xray
+    ack_bps: u64,
+    bandwidth_bps: u64,
+    sent_app_limited: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Handle(NonZeroU64);
+
+#[derive(Debug)]
+struct Slot {
+    generation: u32,
+    snapshot: Option<SendState>,
+}
+
+#[derive(Debug)]
+struct SnapshotPool {
+    slots: Vec<Slot>,
+    free: Vec<u32>,
+    capacity: usize,
+}
+
+impl SnapshotPool {
+    pub(super) fn new(capacity: usize) -> Self {
+        assert!(capacity > 0 && capacity <= u32::MAX as usize);
+        Self {
+            slots: Vec::with_capacity(capacity),
+            free: Vec::with_capacity(capacity),
+            capacity,
+        }
+    }
+
+    fn insert(&mut self, snapshot: SendState) -> Option<Handle> {
+        let index = if let Some(index) = self.free.pop() {
+            index
+        } else if self.slots.len() < self.capacity {
+            let index = self.slots.len() as u32;
+            self.slots.push(Slot {
+                generation: 1,
+                snapshot: None,
+            });
+            index
+        } else {
+            return None;
+        };
+        let slot = &mut self.slots[index as usize];
+        debug_assert!(slot.generation != 0 && slot.snapshot.is_none());
+        slot.snapshot = Some(snapshot);
+        let id = ((slot.generation as u64) << 32) | (u64::from(index) + 1);
+        Some(Handle(
+            NonZeroU64::new(id).expect("index+1 and generation are nonzero"),
+        ))
+    }
+
+    fn take(&mut self, handle: Handle) -> Option<SendState> {
+        let raw = handle.0.get();
+        let low = raw as u32;
+        let index = low.checked_sub(1)? as usize;
+        let generation = (raw >> 32) as u32;
+        let slot = self.slots.get_mut(index)?;
+        if slot.generation != generation || generation == 0 {
+            return None;
+        }
+        let snapshot = slot.snapshot.take()?;
+        // Retire exhausted generations rather than allow a stale handle to
+        // become valid after wrapping 2^32 reuse cycles.
+        if let Some(next) = slot.generation.checked_add(1) {
+            slot.generation = next;
+            self.free.push(index as u32);
+        } else {
+            slot.generation = 0;
+        }
+        Some(snapshot)
+    }
+
+    fn occupied(&self) -> usize {
+        self.slots
+            .iter()
+            .filter(|slot| slot.snapshot.is_some())
+            .count()
+    }
+}
+
+#[allow(dead_code)]
+struct PacketWithHandle {
+    packet: SentPacket,
+    handle: Option<Handle>,
+}
+
+pub(super) struct DeliverySampler {
+    origin: Instant,
+    pool: SnapshotPool,
+    sent_total: u64,
+    acked_total: u64,
+    last_acked_sent_total: u64,
+    last_acked_sent_ns: u64,
+    last_acked_ack_ns: u64,
+    has_last_ack: bool,
+    frame_best: Option<RateSample>,
+    skipped_capacity: u64,
+    integrated_samples: u64,
+    integrated_sends: u64,
+    integrated_discards: u64,
+}
+
+impl DeliverySampler {
+    pub(super) fn new(now: Instant, max_inflight_snapshots: usize) -> Self {
+        Self {
+            origin: now,
+            pool: SnapshotPool::new(max_inflight_snapshots),
+            sent_total: 0,
+            acked_total: 0,
+            last_acked_sent_total: 0,
+            last_acked_sent_ns: 0,
+            last_acked_ack_ns: 0,
+            has_last_ack: false,
+            frame_best: None,
+            skipped_capacity: 0,
+            integrated_samples: 0,
+            integrated_sends: 0,
+            integrated_discards: 0,
+        }
+    }
+
+    fn nanos(&self, at: Instant) -> u64 {
+        at.checked_duration_since(self.origin)
+            .unwrap_or_default()
+            .as_nanos()
+            .min(u64::MAX as u128) as u64
+    }
+
+    /// Called after the packet's size is known. Returns None when the bounded
+    /// pool is full; the packet may still be sent without a rate snapshot.
+    pub(super) fn send(
+        &mut self,
+        _now: Instant,
+        bytes: u64,
+        sent_app_limited: bool,
+    ) -> Option<Handle> {
+        self.integrated_sends = self.integrated_sends.saturating_add(1);
+        self.sent_total = self.sent_total.saturating_add(bytes);
+        let snapshot = SendState {
+            sent_total: self.sent_total,
+            acked_total_at_send: self.acked_total,
+            last_acked_sent_total: self.last_acked_sent_total,
+            last_acked_sent_ns: self.last_acked_sent_ns,
+            last_acked_ack_ns: self.last_acked_ack_ns,
+            last_acked_valid: self.has_last_ack,
+            sent_app_limited,
+        };
+        let handle = self.pool.insert(snapshot);
+        if handle.is_none() {
+            self.skipped_capacity = self.skipped_capacity.saturating_add(1);
+        }
+        handle
+    }
+
+    fn rate(bytes: u64, duration_ns: u64) -> Option<u64> {
+        if duration_ns == 0 {
+            return None;
+        }
+        Some(((bytes as u128 * 1_000_000_000) / duration_ns as u128).min(u64::MAX as u128) as u64)
+    }
+
+    /// Invoked only for a newly ACKed packet removed from sent_packets.
+    /// An explicit stale handle is rejected, while None denotes legitimate
+    /// snapshot exhaustion and still accounts for the ACKed bytes.
+    pub(super) fn ack(
+        &mut self,
+        handle: Option<Handle>,
+        sent_at: Instant,
+        ack_at: Instant,
+        bytes: u64,
+        current_path: bool,
+    ) -> Option<RateSample> {
+        let snapshot = handle.and_then(|handle| self.pool.take(handle));
+        if !current_path {
+            return None;
+        }
+        if handle.is_some() && snapshot.is_none() {
+            return None; // stale or duplicate handle, not a new ACK
+        }
+
+        self.acked_total = self.acked_total.saturating_add(bytes);
+        let sent_ns = self.nanos(sent_at);
+        let ack_ns = self.nanos(ack_at);
+        let Some(state) = snapshot else {
+            // The ACK is real, but a capacity-exhausted snapshot cannot tell
+            // us how many bytes had been sent *at that packet's send time*.
+            // Do not forge a reference point with the current total_sent.
+            self.has_last_ack = false;
+            return None;
+        };
+        self.last_acked_sent_total = state.sent_total;
+        self.last_acked_sent_ns = sent_ns;
+        self.last_acked_ack_ns = ack_ns;
+        self.has_last_ack = true;
+        if !state.last_acked_valid || ack_ns <= state.last_acked_ack_ns {
+            return None;
+        }
+
+        let ack_bps = Self::rate(
+            self.acked_total.saturating_sub(state.acked_total_at_send),
+            ack_ns - state.last_acked_ack_ns,
+        )?;
+        let send_bps = if sent_ns > state.last_acked_sent_ns {
+            Self::rate(
+                state.sent_total.saturating_sub(state.last_acked_sent_total),
+                sent_ns - state.last_acked_sent_ns,
+            )
+        } else {
+            None // Xray treats send rate as +infinity for equal send instants
+        };
+        let sample = RateSample {
+            send_bps,
+            ack_bps,
+            bandwidth_bps: send_bps.map_or(ack_bps, |rate| rate.min(ack_bps)),
+            sent_app_limited: state.sent_app_limited,
+        };
+        if self
+            .frame_best
+            .is_none_or(|prev| sample.bandwidth_bps > prev.bandwidth_bps)
+        {
+            self.frame_best = Some(sample);
+        }
+        Some(sample)
+    }
+
+    /// Drop snapshot state for a packet deemed lost/neutered/discarded.
+    pub(super) fn discard(&mut self, handle: Option<Handle>) -> bool {
+        let removed = handle.is_some_and(|handle| self.pool.take(handle).is_some());
+        if removed {
+            self.integrated_discards = self.integrated_discards.saturating_add(1);
+        }
+        removed
+    }
+
+    /// One ACK frame, not one instant (two frames may share an Instant).
+    pub(super) fn end_acks(&mut self) -> Option<RateSample> {
+        let sample = self.frame_best.take();
+        if sample.is_some() {
+            self.integrated_samples = self.integrated_samples.saturating_add(1);
+        }
+        sample
+    }
+
+    /// Path change invalidates the old link's delivery-rate anchor, but not
+    /// the packet-owned snapshot slots: those stay until ACK/loss/discard.
+    pub(super) fn reset_path_anchor(&mut self) {
+        self.has_last_ack = false;
+        self.last_acked_sent_total = 0;
+        self.last_acked_sent_ns = 0;
+        self.last_acked_ack_ns = 0;
+        self.frame_best = None;
+    }
+
+    pub(super) fn has_current_path_anchor(&self) -> bool {
+        self.has_last_ack
+    }
+
+    pub(super) fn missed_samples_due_to_capacity(&self) -> u64 {
+        self.skipped_capacity
+    }
+
+    pub(super) fn diagnostics(&self) -> (usize, u64, u64, u64, u64) {
+        (
+            self.pool.occupied(),
+            self.integrated_sends,
+            self.acked_total,
+            self.integrated_discards,
+            self.integrated_samples,
+        )
+    }
+}
