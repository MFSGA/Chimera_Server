+
+    let stream = pair.server_streams(server_ch).open(Dir::Uni).unwrap();
+    let payload = vec![0x3c_u8; 2048];
+    pair.server_send(server_ch, stream).write(&payload).unwrap();
+    pair.server_send(server_ch, stream).finish().unwrap();
+    pair.drive_server();
+    let old_inbound = std::mem::take(&mut pair.client.inbound);
+    assert!(!old_inbound.is_empty());
+    let old_occupied = pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0;
+    assert!(old_occupied > 0, "old path packet handles must exist during migration");
+
+    // Start migration without delivering the original path's in-flight bytes.
+    pair.client.addr = SocketAddr::new(
+        Ipv4Addr::LOCALHOST.into(),
+        CLIENT_PORTS.lock().unwrap().next().unwrap(),
+    );
+    pair.client_conn_mut(client_ch).ping();
+    pair.drive_client();
+    pair.drive_server();
+    assert_ne!(
+        pair.server_conn_mut(server_ch).delivery_path_generation(),
+        initial_generation
+    );
+    assert!(
+        pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0 >= old_occupied,
+        "path switch must preserve old packet snapshot ownership"
+    );
+
+    // Deliver path validation before releasing the delayed old-path packets.
+    pair.drive();
+    assert_eq!(pair.server_conn_mut(server_ch).remote_address(), pair.client.addr);
+    assert!(pair.server_conn_mut(server_ch).delivery_path_validation_deadline().is_none());
+
+    // Late old-path packets can now be received/ACKed while a new path is active.
+    pair.client.inbound.extend(old_inbound);
+    pair.drive();
+    let accepted = pair.client_streams(client_ch).accept(Dir::Uni).unwrap();
+    assert_eq!(accepted, stream);
+    let mut received = Vec::new();
+    {
+        let mut recv = pair.client_recv(client_ch, stream);
+        let mut chunks = recv.read(true).unwrap();
+        while let Some(chunk) = chunks.next(usize::MAX).unwrap() {
+            received.extend_from_slice(&chunk.bytes);
+        }
+        let _ = chunks.finalize();
+    }
+    assert_eq!(received, payload);
+    let pool_occupied = pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0;
+    let (tracked, _current, other) =
+        pair.server_conn_mut(server_ch).delivery_live_packet_snapshot_paths();
+    assert_eq!(pool_occupied, tracked, "no orphaned sampler slots");
+    assert_eq!(other, 0, "late old-path packet ACK/loss must release old-path handles");
+}
