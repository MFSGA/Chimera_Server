+// The server must retain a snapshot of an old-path packet while the new
+// path is being validated and then reject that validation at the real timer.
+#[test]
+fn delivery_real_migration_timeout_rolls_back_with_old_path_inflight() {
+    let _guard = subscribe();
+    let mut pair = Pair::default();
+    let (client_ch, server_ch) = pair.connect();
+    pair.drive();
+    let original_client_addr = pair.client.addr;
+    let original_generation = pair.server_conn_mut(server_ch).delivery_path_generation();
+
+    // Real server -> client STREAM packet, not yet received or ACKed.
+    let stream = pair.server_streams(server_ch).open(Dir::Uni).unwrap();
+    let payload = vec![0x5a_u8; 4096];
+    pair.server_send(server_ch, stream).write(&payload).unwrap();
+    pair.server_send(server_ch, stream).finish().unwrap();
+    pair.drive_server();
+    let old_packets = std::mem::take(&mut pair.client.inbound);
+    assert!(!old_packets.is_empty(), "the first path transmitted stream packets");
+    let original_inflight = pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0;
+    assert!(original_inflight > 0, "the old path must have outstanding packet snapshots");
+
+    // Change client source address and send a real ping, causing server migration.
+    pair.client.addr = SocketAddr::new(
+        Ipv4Addr::LOCALHOST.into(),
+        CLIENT_PORTS.lock().unwrap().next().unwrap(),
+    );
+    pair.client_conn_mut(client_ch).ping();
+    pair.drive_client();
+    pair.drive_server();
+
+    assert_eq!(pair.server_conn_mut(server_ch).remote_address(), pair.client.addr);
+    assert_ne!(pair.server_conn_mut(server_ch).delivery_path_generation(), original_generation);
+    let during = pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0;
+    assert!(during >= original_inflight, "old-path outstanding snapshots must survive migration");
+
+    // Drop PATH_CHALLENGE / PATH_RESPONSE exchanges, not the original old-path bytes.
+    pair.client.inbound.clear();
+    let deadline = pair.server_conn_mut(server_ch)
+        .delivery_path_validation_deadline()
+        .expect("migration arms a validation timeout");
+    assert!(deadline > pair.time, "must exercise the scheduled timeout");
+    pair.time = deadline;
+    pair.server_conn_mut(server_ch).handle_timeout(deadline);
+
+    assert_eq!(
+        pair.server_conn_mut(server_ch).remote_address(),
+        original_client_addr,
+        "expired validation must restore previous path"
+    );
+    assert_eq!(pair.server_conn_mut(server_ch).delivery_path_generation(), original_generation);
+    assert!(!pair.server_conn_mut(server_ch).delivery_anchor_valid(),
+        "rollback cannot reuse an ACK anchor from the rejected path");
+    assert!(
+        pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0 >= original_inflight,
+        "pending old-path packet snapshots must not be destroyed by rollback"
+    );
+
+    // Resume the original source and deliver the retained original packets.
+    pair.client.addr = original_client_addr;
+    pair.client.inbound = old_packets;
+    pair.drive();
+    let accepted = pair.client_streams(client_ch).accept(Dir::Uni).unwrap();
+    assert_eq!(accepted, stream);
+    let mut received = Vec::new();
+    {
+        let mut recv = pair.client_recv(client_ch, stream);
+        let mut chunks = recv.read(true).unwrap();
+        while let Some(chunk) = chunks.next(usize::MAX).unwrap() {
+            received.extend_from_slice(&chunk.bytes);
+        }
+        let _ = chunks.finalize();
+    }
+    assert_eq!(received, payload);
+    let pool_occupied = pair.server_conn_mut(server_ch).delivery_sample_diagnostics().0;
+    let owners = pair.server_conn_mut(server_ch).delivery_live_packet_snapshot_paths();
+    eprintln!(
+        "rollback snapshot diagnostic: pool={}, packet owners (all,current,other)={owners:?}",
+        pool_occupied,
+    );
+    assert_eq!(pool_occupied, owners.0, "all snapshots must have live SentPacket owners");
+    assert_eq!(owners.2, 0,
+        "abandoned path snapshots must be released instead of blocking the bounded pool");
+}
