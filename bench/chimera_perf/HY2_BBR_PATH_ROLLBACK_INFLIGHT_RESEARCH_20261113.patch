+            let when = at(t, i as u64 + 1);
+            let handle = s.send(when, 1_200, false);
+            assert!(handle.is_some(), "a released slot must be reusable");
+            all_old.push(handle);
+            if i % 3 == 0 {
+                assert!(s.discard(handle));
+            } else {
+                s.ack(handle, when, at(t, i as u64 + 2), 1_200, true);
+                let _ = s.end_acks();
+            }
+            assert_eq!(s.pool.occupied(), 0);
+            assert!(s.pool.slots.len() <= 32);
+            assert_eq!(s.pool.slots.capacity(), slot_capacity);
+            assert_eq!(s.pool.free.capacity(), freelist_capacity);
+        }
+        assert_eq!(s.skipped_capacity, 0);
+        assert!(s.pool.occupied() == 0);
+        assert!(all_old.windows(2).all(|pair| pair[0] != pair[1]));
+        assert!(!s.discard(all_old[0]));
+    }
+
+    #[test]
+    fn generation_wrap_retires_slot_instead_of_revalidating_old_handle() {
+        let mut pool = SnapshotPool::new(1);
+        let stub = SendState {
+            sent_total: 1,
+            acked_total_at_send: 0,
+            last_acked_sent_total: 0,
+            last_acked_sent_ns: 0,
+            last_acked_ack_ns: 0,
+            last_acked_valid: false,
+            sent_app_limited: false,
+        };
+        pool.slots.push(Slot {
+            generation: u32::MAX,
+            snapshot: None,
+        });
+        pool.free.push(0);
+        let final_generation = pool.insert(stub).expect("last generation usable");
+        assert_eq!(pool.take(final_generation).unwrap().sent_total, 1);
+        assert_eq!(pool.slots[0].generation, 0);
+        assert!(pool.insert(stub).is_none());
+        assert_eq!(pool.take(final_generation).map(|s| s.sent_total), None);
+    }
+
+    #[test]
+    fn two_packet_number_spaces_can_have_independent_handle_lifetimes() {
+        let t = Instant::now();
+        let mut s = DeliverySampler::new(t, 2);
+        let initial = s.send(t, 1_000, false);
+        let data = s.send(at(t, 1), 1_000, false);
+        assert!(s.discard(initial)); // Initial keys discarded
+        assert_eq!(s.pool.occupied(), 1);
+        s.ack(data, at(t, 1), at(t, 2), 1_000, true);
+        assert_eq!(s.pool.occupied(), 0);
+        assert_eq!(s.acked_total, 1_000);
+    }
+}
