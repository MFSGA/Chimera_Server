// Compatibility fixture based on 3x-ui's bundled internal/web/service/config.json.
// The e2e test replaces 62789 with an available loopback port.
{
  "api": {
    "services": ["StatsService", "RoutingService"],
    "tag": "api"
  },
  "metrics": {
    "listen": "127.0.0.1:11111",
    "tag": "metrics_out"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 62789,
      "protocol": "tunnel",
      "settings": { "rewriteAddress": "127.0.0.1" },
      "tag": "api"
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          { "action": "block", "ip": ["geoip:private"] },
          { "action": "allow" }
        ]
      },
      "tag": "direct"
    },
    { "protocol": "blackhole", "settings": {}, "tag": "blocked" }
  ],
  "routing": {
    "rules": [
      { "inboundTag": ["api"], "outboundTag": "api", "type": "field" }
    ]
  }
}
